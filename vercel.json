{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "illustration-portfolio-pink.vercel.app" }],
      "destination": "https://anaben.art/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
